{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodac.dev/schema/o1-authenticated-github-issue-comment-evidence.schema.json",
  "title": "Kodac O1 Authenticated GitHub Issue-Comment Evidence",
  "description": "Structural schema for positive bounded O1 authenticated GitHub issue_comment/created evidence. PR head binding is caller-materialized snapshot evidence and is not represented as webhook-signed head data. Schema acceptance does not grant listener, network, persistence, provider, GitHub mutation, K2, release, or project-completion authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "eventSource",
    "signatureAlgorithm",
    "keyIdentity",
    "deliveryId",
    "deliveryIdentity",
    "payloadSha256",
    "eventName",
    "action",
    "repositoryId",
    "repositoryFullName",
    "pullRequestNumber",
    "pullRequestId",
    "issueId",
    "baseRepositoryId",
    "headRepositoryId",
    "headRepositoryFullName",
    "forkClassification",
    "observedHeadSha",
    "expectedHeadSha",
    "headMatch",
    "headBindingSource",
    "headBindingPolicyIdentity",
    "headBindingEvidenceRefs",
    "commentId",
    "commentNodeId",
    "commentBodySha256",
    "commentBodyByteLength",
    "commentIdentity",
    "actorId",
    "actorLogin",
    "actorType",
    "actorEligibilityPolicyIdentity",
    "actorEligibilityEvidenceRefs",
    "actorEligibilityDecision",
    "replayDecision",
    "authenticationDecision",
    "ingressDecision",
    "eventEvidenceIdentity"
  ],
  "properties": {
    "version": { "const": "kodac-o1-authenticated-github-issue-comment-evidence-v1" },
    "eventSource": { "const": "GITHUB" },
    "signatureAlgorithm": { "const": "HMAC_SHA256" },
    "keyIdentity": { "$ref": "#/$defs/sha256" },
    "deliveryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "deliveryIdentity": { "$ref": "#/$defs/sha256" },
    "payloadSha256": { "$ref": "#/$defs/sha256" },
    "eventName": { "const": "issue_comment" },
    "action": { "const": "created" },
    "repositoryId": { "$ref": "#/$defs/decimalId" },
    "repositoryFullName": { "$ref": "#/$defs/repositoryName" },
    "pullRequestNumber": { "type": "integer", "minimum": 1 },
    "pullRequestId": { "$ref": "#/$defs/decimalId" },
    "issueId": { "$ref": "#/$defs/decimalId" },
    "baseRepositoryId": { "$ref": "#/$defs/decimalId" },
    "headRepositoryId": { "$ref": "#/$defs/decimalId" },
    "headRepositoryFullName": { "$ref": "#/$defs/repositoryName" },
    "forkClassification": { "enum": ["SAME_REPOSITORY", "FORK_REPOSITORY"] },
    "observedHeadSha": { "$ref": "#/$defs/gitSha1" },
    "expectedHeadSha": { "$ref": "#/$defs/gitSha1" },
    "headMatch": { "const": "MATCH" },
    "headBindingSource": { "const": "CALLER_MATERIALIZED_PR_SNAPSHOT" },
    "headBindingPolicyIdentity": { "$ref": "#/$defs/sha256" },
    "headBindingEvidenceRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/evidenceRef" }
    },
    "commentId": { "$ref": "#/$defs/decimalId" },
    "commentNodeId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "commentBodySha256": { "$ref": "#/$defs/sha256" },
    "commentBodyByteLength": { "type": "integer", "minimum": 1, "maximum": 262144 },
    "commentIdentity": { "$ref": "#/$defs/sha256" },
    "actorId": { "$ref": "#/$defs/decimalId" },
    "actorLogin": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9_.\\-\\[\\]]+$"
    },
    "actorType": { "enum": ["User", "Bot", "Organization"] },
    "actorEligibilityPolicyIdentity": { "$ref": "#/$defs/sha256" },
    "actorEligibilityEvidenceRefs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/evidenceRef" }
    },
    "actorEligibilityDecision": { "const": "ELIGIBLE" },
    "replayDecision": { "const": "UNSEEN" },
    "authenticationDecision": { "const": "AUTHENTICATED" },
    "ingressDecision": { "const": "ACCEPT" },
    "eventEvidenceIdentity": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitSha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "decimalId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
    "repositoryName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 201,
      "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"
    },
    "evidenceRef": { "type": "string", "minLength": 1, "maxLength": 1024 }
  }
}
