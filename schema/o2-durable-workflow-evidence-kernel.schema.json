{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodac.dev/schema/o2-durable-workflow-evidence-kernel.schema.json",
  "title": "Kodac O2 Durable Workflow Transition Evidence",
  "description": "Structural schema for positive bounded O2 pure-data workflow transition evidence. Schema acceptance is not persistence, scheduling, crash recovery, side-effect authority, GitHub authority, provider execution, or project completion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "workflowDefinitionIdentity",
    "workflowRunIdentity",
    "workflowStepIdentity",
    "stepKey",
    "stepType",
    "attemptNumber",
    "attemptIdentity",
    "idempotencyIdentity",
    "retryClass",
    "priorAttemptIdentity",
    "subjectRepositoryIdentity",
    "canonicalBase",
    "subjectRevisionIdentity",
    "policyIdentity",
    "triggerEvidenceIdentity",
    "leaseIdentity",
    "leaseObservationIdentity",
    "leaseEpoch",
    "previousState",
    "nextState",
    "transitionKind",
    "priorTransitionIdentity",
    "cancellationDisposition",
    "resumeDecision",
    "resumeBindingIdentity",
    "definitionDriftDecision",
    "migrationIdentity",
    "continuationDecision",
    "inputEvidenceIdentities",
    "outputEvidenceIdentities",
    "errorIdentity",
    "transitionIdentity"
  ],
  "properties": {
    "version": { "const": "kodac-o2-durable-workflow-evidence-kernel-v1" },
    "workflowDefinitionIdentity": { "$ref": "#/$defs/sha256" },
    "workflowRunIdentity": { "$ref": "#/$defs/sha256" },
    "workflowStepIdentity": { "$ref": "#/$defs/sha256" },
    "stepKey": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "stepType": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "attemptNumber": { "type": "integer", "minimum": 1, "maximum": 32 },
    "attemptIdentity": { "$ref": "#/$defs/sha256" },
    "idempotencyIdentity": { "$ref": "#/$defs/sha256" },
    "retryClass": { "enum": ["INITIAL", "SAFE_REPLAY", "IDEMPOTENT_REREAD", "NEW_INTELLIGENCE_ATTEMPT", "SIDE_EFFECT_RETRY"] },
    "priorAttemptIdentity": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "subjectRepositoryIdentity": { "$ref": "#/$defs/sha256" },
    "canonicalBase": { "$ref": "#/$defs/gitSha1" },
    "subjectRevisionIdentity": { "$ref": "#/$defs/gitSha1" },
    "policyIdentity": { "$ref": "#/$defs/sha256" },
    "triggerEvidenceIdentity": { "$ref": "#/$defs/sha256" },
    "leaseIdentity": { "$ref": "#/$defs/sha256" },
    "leaseObservationIdentity": { "$ref": "#/$defs/sha256" },
    "leaseEpoch": { "type": "integer", "minimum": 1 },
    "previousState": { "$ref": "#/$defs/runState" },
    "nextState": { "$ref": "#/$defs/runState" },
    "transitionKind": { "enum": ["START", "RETRY", "REQUEST_CANCELLATION", "COMPLETE_CANCELLATION", "SUCCEED", "FAIL", "RESUME"] },
    "priorTransitionIdentity": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "cancellationDisposition": { "enum": ["NOT_REQUESTED", "CANCEL_ALLOWED", "COMMITTED_NO_UNDO", "UNKNOWN_BLOCKED"] },
    "resumeDecision": { "enum": ["NOT_APPLICABLE", "ELIGIBLE", "STALE", "MIGRATION_REQUIRED"] },
    "resumeBindingIdentity": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "definitionDriftDecision": { "enum": ["UNCHANGED", "MIGRATION_REQUIRED", "MIGRATED"] },
    "migrationIdentity": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "continuationDecision": { "enum": ["ALLOW", "BLOCK"] },
    "inputEvidenceIdentities": { "$ref": "#/$defs/evidenceIdentityArray" },
    "outputEvidenceIdentities": { "$ref": "#/$defs/evidenceIdentityArray" },
    "errorIdentity": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "transitionIdentity": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "runState": {
      "enum": ["PENDING", "ACTIVE", "CANCELLATION_REQUESTED", "CANCELLED", "SUCCEEDED", "FAILED", "STALE", "MIGRATION_REQUIRED"]
    },
    "evidenceIdentityArray": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    }
  }
}
