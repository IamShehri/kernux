{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodac.dev/schema/p7-risk-coverage-evidence-binding.schema.json",
  "title": "Kodac P7-R25 Risk Coverage Evidence Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "evidenceIdentity",
    "state",
    "repositoryIdentity",
    "canonicalBase",
    "targetHead",
    "targetTree",
    "changedPathSetIdentity",
    "reviewUniverseIdentity",
    "securityPrescanEvidenceIdentity",
    "sourceSetIdentity",
    "ruleSetIdentity",
    "riskTaxonomyIdentity",
    "riskApplicabilityEvidenceIdentity",
    "reviewUniversePathCount",
    "reviewableTextPathCount",
    "nonReviewablePathCount",
    "nonReviewableDispositionCounts",
    "coverageDebtIdentity",
    "applicableRiskSet",
    "notApplicableRiskSet",
    "unknownApplicabilityRiskSet",
    "coveredRiskSet",
    "uncoveredRiskSet",
    "riskRecords",
    "riskCoverageState"
  ],
  "properties": {
    "version": { "const": "p7-r25-risk-coverage-evidence-binding-v1" },
    "evidenceIdentity": { "$ref": "#/$defs/sha256" },
    "state": { "const": "RISK_COVERAGE_EVIDENCE_BOUND_ONLY" },
    "repositoryIdentity": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "canonicalBase": { "$ref": "#/$defs/sha1" },
    "targetHead": { "$ref": "#/$defs/sha1" },
    "targetTree": { "$ref": "#/$defs/sha1" },
    "changedPathSetIdentity": { "$ref": "#/$defs/sha256" },
    "reviewUniverseIdentity": { "$ref": "#/$defs/sha256" },
    "securityPrescanEvidenceIdentity": { "$ref": "#/$defs/sha256" },
    "sourceSetIdentity": { "$ref": "#/$defs/sha256" },
    "ruleSetIdentity": { "$ref": "#/$defs/sha256" },
    "riskTaxonomyIdentity": { "$ref": "#/$defs/sha256" },
    "riskApplicabilityEvidenceIdentity": { "$ref": "#/$defs/sha256" },
    "reviewUniversePathCount": { "type": "integer", "minimum": 0, "maximum": 64 },
    "reviewableTextPathCount": { "type": "integer", "minimum": 0, "maximum": 64 },
    "nonReviewablePathCount": { "type": "integer", "minimum": 0, "maximum": 64 },
    "nonReviewableDispositionCounts": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/dispositionCount" }
    },
    "coverageDebtIdentity": { "$ref": "#/$defs/sha256" },
    "applicableRiskSet": { "$ref": "#/$defs/riskSet" },
    "notApplicableRiskSet": { "$ref": "#/$defs/riskSet" },
    "unknownApplicabilityRiskSet": { "$ref": "#/$defs/riskSet" },
    "coveredRiskSet": { "$ref": "#/$defs/riskSet" },
    "uncoveredRiskSet": { "$ref": "#/$defs/riskSet" },
    "riskRecords": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/riskRecord" }
    },
    "riskCoverageState": {
      "enum": [
        "ACCOUNTED_NO_UNCOVERED_OR_UNKNOWN",
        "HAS_UNCOVERED_RISK",
        "HAS_UNKNOWN_APPLICABILITY",
        "HAS_UNCOVERED_AND_UNKNOWN"
      ]
    }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "riskId": {
      "enum": [
        "credential_access",
        "data_exfiltration",
        "encoded_execution",
        "persistence",
        "prompt_injection",
        "remote_execution",
        "semantic_logic_abuse",
        "supply_chain_payload"
      ]
    },
    "ruleId": {
      "enum": [
        "cloud_metadata_access",
        "credential_path_access",
        "decode_then_execute",
        "persistence_mechanism_indicator",
        "prompt_injection_indicator",
        "remote_pipe_to_shell",
        "reverse_shell_indicator",
        "sensitive_data_exfiltration_indicator",
        "ssh_key_write_indicator",
        "suspicious_executable_download"
      ]
    },
    "riskSet": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/riskId" }
    },
    "dispositionCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentDisposition", "count"],
      "properties": {
        "contentDisposition": {
          "enum": [
            "opaque_binary_or_compiled",
            "generated_or_derived",
            "referenced_hidden_payload",
            "unreadable",
            "unsupported_or_suspicious_encoding",
            "oversized",
            "git_lfs_pointer",
            "policy_excluded",
            "not_applicable_deleted"
          ]
        },
        "count": { "type": "integer", "minimum": 0, "maximum": 64 }
      }
    },
    "riskRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "riskId",
        "riskVersion",
        "applicability",
        "applicabilityEvidenceIdentities",
        "staticRuleIds",
        "staticSignalEvidenceIdentities",
        "reviewerFindingEvidenceIdentities",
        "coverageMethods",
        "coverageDisposition"
      ],
      "properties": {
        "riskId": { "$ref": "#/$defs/riskId" },
        "riskVersion": { "const": "1" },
        "applicability": { "enum": ["APPLICABLE", "NOT_APPLICABLE", "UNKNOWN"] },
        "applicabilityEvidenceIdentities": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "staticRuleIds": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/ruleId" }
        },
        "staticSignalEvidenceIdentities": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "reviewerFindingEvidenceIdentities": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "coverageMethods": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["DETERMINISTIC_PRESCAN", "REVIEWER_FINDING_REFERENCE"] }
        },
        "coverageDisposition": {
          "enum": [
            "COVERED_BY_BOUNDED_METHOD",
            "UNCOVERED_APPLICABLE",
            "NOT_APPLICABLE",
            "UNKNOWN_APPLICABILITY"
          ]
        }
      }
    }
  }
}
