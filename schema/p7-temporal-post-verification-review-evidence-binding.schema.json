{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodac.dev/schema/p7-temporal-post-verification-review-evidence-binding.schema.json",
  "title": "Kodac P7-R21 Temporal Post-Verification Exact-Head Review Evidence Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "evidenceIdentity",
    "state",
    "sourceExactTargetHeadReviewRunEvidenceIdentity",
    "sourceVerificationEngineCompletionEventEvidenceIdentity",
    "repositoryIdentity",
    "canonicalBase",
    "targetHead",
    "reviewRunIdentity",
    "reviewStatus",
    "reviewedHead",
    "evaluatedHead",
    "verificationCompletedEventEmittedAt",
    "reviewStartedAt",
    "reviewCompletedAt",
    "temporalEvidenceIdentity"
  ],
  "properties": {
    "version": { "const": "p7-r21-temporal-post-verification-review-evidence-binding-v1" },
    "evidenceIdentity": { "$ref": "#/$defs/sha256" },
    "state": { "const": "TEMPORAL_POST_VERIFICATION_EXACT_HEAD_REVIEW_EVIDENCE_BOUND_ONLY" },
    "sourceExactTargetHeadReviewRunEvidenceIdentity": { "$ref": "#/$defs/sha256" },
    "sourceVerificationEngineCompletionEventEvidenceIdentity": { "$ref": "#/$defs/sha256" },
    "repositoryIdentity": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "canonicalBase": { "$ref": "#/$defs/gitSha1" },
    "targetHead": { "$ref": "#/$defs/gitSha1" },
    "reviewRunIdentity": { "$ref": "#/$defs/sha256" },
    "reviewStatus": { "const": "COMPLETED" },
    "reviewedHead": { "$ref": "#/$defs/gitSha1" },
    "evaluatedHead": { "$ref": "#/$defs/gitSha1" },
    "verificationCompletedEventEmittedAt": { "$ref": "#/$defs/timestamp" },
    "reviewStartedAt": { "$ref": "#/$defs/timestamp" },
    "reviewCompletedAt": { "$ref": "#/$defs/timestamp" },
    "temporalEvidenceIdentity": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
