{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodac.dev/schema/p9-r3-targeted-requalification-requirement.schema.json",
  "title": "Kodac P9-R3 Targeted Requalification Requirement Result",
  "description": "Pure bounded evidence projection from an exact runtime-validated P9-R2 impacted-subject result. Runtime validation additionally reconstructs P9-R2 from its original bounded source input, verifies exact requirement membership, and recomputes all identities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "revision",
    "sourceResultIdentity",
    "changedDependencyKeys",
    "requirements",
    "resultIdentity"
  ],
  "properties": {
    "version": { "const": "p9-r3-targeted-requalification-requirement-v1" },
    "revision": { "$ref": "#/$defs/revision" },
    "sourceResultIdentity": { "$ref": "#/$defs/sha256" },
    "changedDependencyKeys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/dependencyKey" }
    },
    "requirements": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/requirement" }
    },
    "resultIdentity": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "repositoryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?:[^\\u0000\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])+$"
    },
    "dependencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-z0-9][a-z0-9._:/-]*$"
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryId", "canonicalBase", "candidateHead"],
      "properties": {
        "repositoryId": { "$ref": "#/$defs/repositoryId" },
        "canonicalBase": { "$ref": "#/$defs/gitCommit" },
        "candidateHead": { "$ref": "#/$defs/gitCommit" }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjectIdentity",
        "decisionIdentity",
        "matchedChangedDependencyKeys",
        "state",
        "continuation",
        "requalification",
        "requirementIdentity"
      ],
      "properties": {
        "subjectIdentity": { "$ref": "#/$defs/sha256" },
        "decisionIdentity": { "$ref": "#/$defs/sha256" },
        "matchedChangedDependencyKeys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dependencyKey" }
        },
        "state": { "const": "STALE" },
        "continuation": { "const": "BLOCK" },
        "requalification": { "const": "REQUIRED" },
        "requirementIdentity": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
